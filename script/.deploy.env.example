# =============================================================================
# Identifiants pour déployer depuis IntelliJ (script/deploy-from-ide.sh).
# Copier ce fichier en script/.deploy.env — ce fichier-là est ignoré par Git.
# =============================================================================

# Registry : login GitHub + token « classic » avec write:packages et read:packages
GHCR_USER=
GHCR_TOKEN=

# Accès au k3s de l'Ubuntu : copie de /etc/rancher/k3s/k3s.yaml sur ton PC
# (remplacer 127.0.0.1 par l'adresse de l'Ubuntu si ce n'est pas une WSL en mode mirrored)
KUBECONFIG=C:/Users/<ton-utilisateur>/.kube/k3s-ubuntu.yaml

# Adresse publique du site, servie par le tunnel Cloudflare (vide = uniquement en local)
PUBLIC_URL=
# Adresse publique de Keycloak s'il a son propre sous-domaine (vide = même adresse que PUBLIC_URL)
KEYCLOAK_PUBLIC_URL=

# Adresse qui expose les NodePorts (front 30080, Keycloak 30090, gateway 31803)
TARGET_HOST=localhost

# Mot de passe des keystores mTLS : le même que le credential Jenkins « mtls-p12-password »
P12_PASSWORD=

# Certificats mTLS. Laisser commenté si Jenkins a déjà déployé : les certificats du cluster sont
# alors conservés. Pour partager ceux de Jenkins, pointer vers son dossier :
# MTLS_OUT_DIR=C:/ProgramData/Jenkins/.jenkins/mtls

# Numéro client du compte de test (claim numeroClient exigé pour passer commande)
# APP_NUMERO_CLIENT=CLI-00001

# Lancer les tests Maven avant de déployer (0 = non, plus rapide)
RUN_TESTS=0

# Tag à redéployer avec la configuration « Redéployer » (sinon : latest)
# IMAGE_TAG=
